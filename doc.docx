POST	/api/v1/auth/customer/register-verify	auth.py	-	Customer OTP verify + create
POST	/api/v1/auth/customer/login-request	auth.py	-	Customer login OTP request
POST	/api/v1/auth/customer/login-verify	auth.py	-	Customer login OTP verify
GET	/api/v1/auth/me	auth.py	current_user	Get profile
PATCH	/api/v1/auth/me	auth.py	current_user	Update profile
POST	/api/v1/auth/delete-account	auth.py	current_user	Soft delete
POST	/api/v1/auth/send-otp	auth.py	-	Generic OTP
POST	/api/v1/auth/verify-otp	auth.py	-	Verify OTP
POST	/api/v1/auth/dealer-register	auth.py	-	Dealer registration
